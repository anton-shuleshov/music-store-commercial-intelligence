	column Revenue
		dataType: double
		lineageTag: 38f84c3a-11bc-463e-a393-c890b090f317
		summarizeBy: sum
		sourceColumn: Revenue

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = SUM('Music Sales'[Revenue])
		formatString: "$"#,0.00
		lineageTag: c6401f8e-77c1-414e-bc33-a003a8622210

	measure 'Units Sold' = SUM('Music Sales'[Quantity])
		formatString: #,0
		lineageTag: b1bf4e26-522e-421f-8056-d8ef84c43480

	measure 'Customers' = DISTINCTCOUNT('Music Sales'[CustomerID])
		formatString: #,0
		lineageTag: 2efba428-8150-4e85-a6a2-38dfab55837f

	measure 'Orders' = DISTINCTCOUNT('Music Sales'[InvoiceID])
		formatString: #,0
		lineageTag: 4afe4c42-c186-4a59-b423-d55a38014fee

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Orders])
		formatString: "$"#,0.00
		lineageTag: 4415f71f-7a4c-45da-8b5e-2105468a82de

	measure 'Revenue per Customer' = DIVIDE([Total Revenue], [Customers])
		formatString: "$"#,0.00
		lineageTag: 92bd0e40-cb8e-4f1a-843e-85e5ec0362ba

	measure 'Items per Order' = DIVIDE([Units Sold], [Orders])
		formatString: 0.0
		lineageTag: 87762b6c-1e0b-4a1a-8bce-d5b2a05a2d94

	measure 'Orders per Customer' = DIVIDE([Orders], [Customers])
		formatString: 0.0
		lineageTag: a569944f-c9e2-46dd-82ae-7be8f7242d69

	measure 'Unique Artists' = DISTINCTCOUNT('Music Sales'[Artist])
		formatString: #,0
		lineageTag: 0fe41af4-c6d3-497e-89c0-a486b904a925

	measure 'Unique Tracks' = DISTINCTCOUNT('Music Sales'[Track])
		formatString: #,0
		lineageTag: b38e0087-4a35-4695-baff-8309deeaa3b0

	measure 'Unique Genres' = DISTINCTCOUNT('Music Sales'[Genre])
		formatString: #,0
		lineageTag: fb260b5a-12b0-446f-92e6-b8e2271b75b7

	measure 'Unique Countries' = DISTINCTCOUNT('Music Sales'[Country])
		formatString: #,0
		lineageTag: a47e9816-0f14-411f-a37b-885965725344

	measure 'Average Unit Price' = DIVIDE([Total Revenue], [Units Sold])
		formatString: "$"#,0.00
		lineageTag: 529978ed-4fe0-45f4-89f2-527e6f06924e

	measure 'Customer Repeat Rate' = DIVIDE(COUNTROWS(FILTER(VALUES('Music Sales'[CustomerID]), CALCULATE(DISTINCTCOUNT('Music Sales'[InvoiceID])) > 1)), [Customers])
		formatString: 0.0%
		lineageTag: 64040ef5-0d47-495f-b162-dfcddae00284

